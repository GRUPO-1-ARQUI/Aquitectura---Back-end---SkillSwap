/* --- (NUEVO) Estilos Videollamada (CORREGIDOS) --- */

/* 1. Contenedor Principal de la Sección */
/* Asegura que la sección ocupe el espacio pero sin afectar el layout interno incorrectamente */
.seccion-videollamada-principal {
    width: 100%;
    height: 100vh; /* Ocupa toda la altura */
    background-color: #000; /* Fondo negro de base */
    display: none; /* Se oculta por defecto (controlado por JS) */
    flex-direction: column;
}

.seccion-videollamada-principal.activa {
    display: flex !important; /* Se muestra como flex cuando está activa */
}

/* 2. Wrapper del contenido (Video + Sidebar) */
.videollamada-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1; /* Crece para llenar el espacio */
    height: 100%;
    overflow: hidden;
}

/* 3. Layout Central (Video Grande a la Izq / Sidebar a la Der) */
.videollamada-layout {
    display: flex;
    flex: 1; /* Ocupa todo el espacio vertical disponible menos la barra de controles */
    overflow: hidden; /* Evita scroll innecesario */
}

/* --- Video Principal --- */
.video-screen-principal {
    flex: 1; /* Toma todo el espacio restante (el sidebar tiene ancho fijo o flex menor) */
    background-color: #121212;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
}

.img-video-full {
    width: 100%;
    height: 100%;
    object-fit: contain; /* 'contain' para ver toda la imagen sin recortes, o 'cover' para llenar */
}

.etiqueta-nombre {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    z-index: 10;
}

/* --- Barra Lateral (Participantes) --- */
.sidebar-participantes {
    width: 280px; /* Ancho fijo para la barra lateral */
    background-color: #1e1e1e;
    border-left: 1px solid #333;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    overflow-y: auto;
    flex-shrink: 0; /* Evita que se encoja */
}

.tarjeta-video-mini {
    width: 100%;
    height: 160px; /* Altura fija para las miniaturas */
    background-color: #000;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 2px solid transparent;
}

.tarjeta-video-mini:hover {
    border-color: #005a9c;
}

.img-video-mini {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.etiqueta-nombre-mini {
    position: absolute;
    bottom: 5px;
    left: 5px;
    background-color: rgba(0,0,0,0.6);
    color: white;
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
}

.info-llamada-mini {
    margin-top: auto;
    color: #888;
    text-align: center;
    font-size: 12px;
    padding-top: 10px;
}

/* --- Barra de Controles (Inferior) --- */
.controles-videollamada-bar {
    height: 80px;
    background-color: #1e1e1e;
    border-top: 1px solid #333;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
}

.btn-control-llamada {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    background-color: #3c4043;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
