  padding: 10px;
  border-radius: 8px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.elementos-nosotros-txt:hover {
  transform: translateY(-5px); /* Eleva tarjeta */
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1); /* Añade sombra */
}

