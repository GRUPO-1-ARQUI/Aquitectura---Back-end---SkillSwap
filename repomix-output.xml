/* Estilos para el contenedor del chat */
.chat-container {
    height: calc(100vh - 75px); 
    width: 100%;
    margin-top: 75px; 
    
    display: flex;
    flex-direction: column; 
    background-color: #f2f0f5; 
}
.chat-boton-enviar{
    background-color: transparent;
    border: none;
    cursor: pointer;
    margin-left: 10px;
    font-weight: bold;
    color: var(--primary-color, #005a9c); /* Usa tu color principal */
    font-size: 14px; /* Ajusta según necesites */
}

.chat-boton-enviar:hover {
    transform: scale(1.1);
}

/* Sub-cabecera (barra oscura) */
.chat-sub-header {
    background-color: var(--white-color); 
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    flex-shrink: 0;
    
}

.chat-header-perfil {
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-perfil-foto {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #555; 
}

.chat-perfil-nombre {
    font-size: 18px;
    font-weight: 600; 
}

.chat-header-iconos {
    display: flex;
    gap: 15px;
    align-items: center;
}

.chat-icono {
    font-size: 24px;
    cursor: pointer;
}

.btn-header-chat {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--primary-color, #005a9c); /* Usa el color del tema */
    padding: 5px;
    border-radius: 50%;
    transition: background-color 0.2s ease, transform 0.2s ease;
    display: flex; /* Para centrar el SVG */
    align-items: center;
    justify-content: center;
}

.btn-header-chat:hover {
    background-color: rgba(0, 0, 0, 0.05); /* Fondo gris suave al pasar el mouse */
    transform: scale(1.1);
}

/* Ajuste para modo oscuro */
body.dark-mode .btn-header-chat {
    color: var(--text-color);
}
body.dark-mode .btn-header-chat:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

body.dark-mode {
    background-color: #202020;
    color: var(--text-color);
}

body.dark-mode .barra-navegacion {
    background-color: #1a1a1a;
    border-bottom: 1px solid #333;
}

/* Área principal de mensajes */
.area-mensajes {
    flex-grow: 1; 
    overflow-y: auto; 
    padding: 20px;
    
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* Estilo base para todas las burbujas de mensaje */
.burbuja-mensaje {
    padding: 12px 18px;
    border-radius: 20px;
    max-width: 60%;
    font-size: 15px;
    line-height: 1.4;
    display: inline-block; 
}

/* Burbujas de mensajes enviados */
.burbuja-mensaje.enviado {
    background-color: #a99dca; 
    color: white;
    align-self: flex-end; 
    border-bottom-right-radius: 6px; 
}

/* Burbujas de mensajes recibidos */
.burbuja-mensaje.recibido {
    background-color: #d4d4d4; 
    color: #212529; 
    align-self: flex-start; 
    border-bottom-left-radius: 6px; 
}

/* Área inferior para escribir */
.chat-input-area {
    background-color: #ffffff;
    padding: 15px 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 1px solid #c7c6cd;
    flex-shrink: 0; 
}

.chat-boton-adjuntar {
    font-size: 28px;
    font-weight: 600;
    color: #555;
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    line-height: 45px; 
    text-align: center;
}

.chat-input-texto {
    flex-grow: 1;
    border: none;
    padding: 12px 15px;
    font-size: 16px;
    background-color: #f7f7f7; 
    border-radius: 20px;
}

.chat-input-texto:focus {
    outline: none;
    background-color: #fff;
    border: 1px solid #005a9c; 
}

.chat-boton-enviar {
    font-size: 24px;
    color: #005a9c; 
    background: none;
    border: none;
    cursor: pointer;
    transform: rotate(-45deg); 
    padding-bottom: 5px;
}

.perfil-nav-video {
    display: flex;
    align-items: center;
    gap: 15px; 
}

.icono-nav-video {
    font-size: 22px; 
    text-decoration: none;
    color: #333;
    padding: 5px;
}

.icono-nav-video:hover {
    color: #193b69; 
}

.nombre-usuario-video {
    font-weight: 600; 
    font-size: 16px;
    color: black; 
}

.foto-perfil-nav-video {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ddd;
}

