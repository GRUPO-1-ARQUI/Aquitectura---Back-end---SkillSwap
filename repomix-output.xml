/* --- (NUEVO) Estilos Sección Calificación --- */

.seccion-calificar-estudiante {
    display: flex; /* Oculto por defecto (controlado por JS), pero cuando active flex */
    justify-content: center;
    align-items: center;
    height: 100vh; /* Ocupa toda la pantalla */
    background-color: rgba(0, 0, 0, 0.8); /* Fondo oscuro transparente */
}

/* Tarjeta Central */
.calificacion-container {
    background-color: var(--white-color);
    width: 100%;
    max-width: 500px;
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    animation: popIn 0.3s ease;
}

@keyframes popIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.calificacion-header h2 {
    color: var(--primary-color);
    margin-bottom: 10px;
}

.calificacion-avatar img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--background-color);
    margin: 20px 0;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

/* Sistema de Estrellas (CSS Only) */
.calificacion-estrellas {
    display: flex;
    justify-content: center;
    flex-direction: row-reverse; /* Invertimos para que el hover funcione de izq a der */
    margin-bottom: 20px;
}

.calificacion-estrellas input {
    display: none; /* Ocultamos los radio buttons */
}

.calificacion-estrellas label {
    font-size: 40px;
    color: #ddd;
    cursor: pointer;
    transition: color 0.2s;
}

.calificacion-estrellas label:hover,
.calificacion-estrellas label:hover ~ label,
.calificacion-estrellas input:checked ~ label {
    color: #ffc107; /* Color amarillo estrella */
}

/* Comentario */
.calificacion-comentario textarea {
    width: 100%;
    height: 100px;
    padding: 15px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background-color: var(--background-color);
    resize: none;
    font-family: inherit;
    margin-bottom: 20px;
    box-sizing: border-box; /* Evita que se salga del contenedor */
}

/* Botones */
.calificacion-acciones {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.btn-enviar-calificacion {
    background-color: var(--primary-color, #005a9c);
    color: white;
    border: none;
    padding: 12px 30px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s;
}

.btn-enviar-calificacion:hover {
    transform: scale(1.05);
}

.btn-omitir-calificacion {
    background-color: transparent;
    color: #777;
    border: 1px solid #ddd;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
}

.btn-omitir-calificacion:hover {
    background-color: #f5f5f5;
    color: #333;
}

.nombre-verificado {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nombre-calificar {
    font-size: 28px;
    font-weight: 700;
    color: #212529;
}

.icono-verificado {
    font-size: 24px;
    color: #007bff; /* Un azul común para verificación, similar a tu estilo */
    text-decoration: none;
}

.estrellas-calificacion {
    display: flex;
    gap: 10px;
}

.estrella-icono {
    font-size: 40px;
    color: #ffc107; 
    cursor: pointer;
    transition: transform 0.2s ease-in-out;
    text-decoration: none;
}

.estrella-icono:hover {
    transform: scale(1.1);
}

.comentarios-calificacion {
    display: flex;
    gap: 20px;
    width: 100%;
    margin-top: 15px;
}

.campo-comentario {
    width: 100%;
    height: 120px;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 15px;
    font-size: 16px;
    color: #333;
