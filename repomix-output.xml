}

/* Tablets y pantallas medianas */
@media screen and (max-width: 1024px) 
{
    .division-contenido-row 
    {
        flex-direction: column-reverse;
        gap: 30px;
        align-items: center;

    }

    .elementos-nosotros-txt
    {
        width: 65%;
    }

    .division-nosotros-ima img {
        width: 80%;
        max-width: 600px;
    }

    .llamado-accion-texto {
        font-size: 36px;
        width: 90%;
    }

    .seccion-nosotros {
        margin: 30px;
    }

    .barra-navegacion {
        padding: 0 10px;
    }
}

/* Móviles (smartphones) */
@media screen and (max-width: 768px) {
    
    /* 1. EL CONTENEDOR DEL MENÚ (EL CUADRO BLANCO) */
    .menu-horizontal-opciones {
        display: flex;
        flex-direction: column; 
        
        /* CAMBIO CLAVE 1: Alinear a la izquierda */
        align-items: flex-start; 
        
        gap: 20px;
        padding: 30px 25px; /* Espacio interno */
        background-color: #ffffff;
        
        position: fixed; /* Fixed es mejor para menús laterales */
        top: 75px; /* Altura de tu navbar para que no la tape */
        
        /* CAMBIO CLAVE 2: Ancho reducido (ya no 100%) */
        width: 260px; 
        height: calc(100vh - 75px); /* Que ocupe todo el alto disponible */
        
        /* Estado inicial: Oculto a la izquierda */
        left: -100%; 
        
        transition: left 0.3s ease;
        z-index: 1000;
        
        /* Sombra suave solo al lado derecho para dar profundidad */
        box-shadow: 5px 0 15px rgba(0,0,0,0.1);
        border-right: 1px solid #eee;
    }

    /* ESTADO ACTIVO: Esto hace que aparezca */
    .menu-horizontal.activo .menu-horizontal-opciones {
        left: 0;
    }

    /* 2. AJUSTES DE LOS ENLACES (TEXTO) */
    .menu-horizontal-opciones li {
        width: 100%; /* Para que el área de click sea ancha */
    }
    
    .menu-horizontal-opciones li a {
        display: block;
        width: 100%;
        text-align: left; /* Asegurar texto a la izquierda */
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0; /* Línea separadora sutil opcional */
    }

    /* 3. BOTONES (Iniciar sesión / Registrarse) */
    .btn-iniciarsesion,
    .btn-registrase {
        width: 100%;
        text-align: center;
        margin-top: 5px;
        /* Quitamos margin-left/right auto para que respeten el flex-start */
    }

    /* 4. HAMBURGUESA (Se mantiene igual) */
    .menu-hamburguesa {
        display: flex;
        flex-direction: column;
        cursor: pointer;
        gap: 5px;
        padding: 10px;
        z-index: 1100;
    }

    .menu-hamburguesa span {
        width: 30px;
        height: 3px;
        background-color: #000;
        transition: 0.3s;
    }

}

/* --- ARREGLO MENU HAMBURGUESA DROPDOWN --- */
@media (max-width: 768px) { /* Asegúrate que este ancho coincida con tu punto de quiebre móvil */
    
    /* 1. Quitamos la posición flotante para que caiga como lista normal */
    .dropdown-content {
        position: static; /* Importante: Esto evita que "salga para el costado" */
        display: none;    /* Oculto por defecto */
        width: 100%;      /* Que ocupe todo el ancho disponible */
        box-shadow: none; /* Quitamos sombras para que se vea limpio */
        padding-left: 20px; /* Un poco de sangría para que se note que es sub-menú */
        background-color: rgba(0,0,0,0.05); /* Un fondo sutil opcional */
    }

    /* 2. Clase que usaremos con JavaScript para abrirlo */
    .dropdown-content.activo {
        display: block;
    }
    
    /* Opcional: Ajustar el enlace principal para que parezca botón */
    .dropbtn {
        width: 100%;
        display: block;
    }
}

@media (max-width: 768px) {
    /* 1. Ocultamos el submenú por defecto */
    #submenu-alianzas {
        display: none !important; /* El !important asegura que borre cualquier rastro anterior */
        position: static;
        width: 100%;
        box-shadow: none;
    }

    /* 2. MUY IMPORTANTE: Desactivamos el hover de escritorio */
    /* Esto evita que se abra solo con "pasar el dedo" o al cargar */
    .dropdown:hover .dropdown-content {
        display: none; 
    }

    /* 3. Solo se muestra si JavaScript le pone la clase 'activo' */
    #submenu-alianzas.activo {
        display: block !important;
    }
}
