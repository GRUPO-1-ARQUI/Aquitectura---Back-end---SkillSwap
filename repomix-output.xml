.llamado-accion-boton2,
.contact-button {
  /* Añadimos una transición suave para los efectos */
  transition: transform 0.2s ease-in-out, filter 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.btn-iniciarsesion:hover,
.btn-registrase:hover,
.btn-guardar-dominio:hover,
.btn-guardar-habilidad:hover,
.llamado-accion-boton:hover,
.llamado-accion-boton2:hover,
