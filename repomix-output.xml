    /* Ajuste de la barra de búsqueda para que no estorbe en modo detalle */
    .contenido-verificaciones-coord.mostrando-detalle ~ .barra-busqueda-coord,
    .contenido-verificaciones-coord.mostrando-detalle ~ .barra-acciones-coord {
