    display: block;
    width: 100%;
}

/* 2. El menú desplegable (RESET TOTAL) */
#dropdown-notificaciones {
    /* Quitamos cualquier posición flotante que venga del escritorio */
    position: static !important;
    float: none !important;
    
    /* Diseño visual "Integrado" */
    width: 100% !important;
    box-shadow: none !important; /* Sin sombras para que parezca parte del menú */
    border: none !important;
    border-top: 1px solid #f0f0f0 !important; /* Una linea sutil arriba */
