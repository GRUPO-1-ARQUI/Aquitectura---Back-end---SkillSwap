    padding: 60px 20px; 
    box-sizing: border-box;
}

.grid-resultados {
    display: grid;
    /* Crea 2 columnas en pantallas grandes, 
      y 1 columna en pantallas más pequeñas.
    */
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 25px;
    width: 100%;
    /* Un max-width un poco más grande para que quepan 
