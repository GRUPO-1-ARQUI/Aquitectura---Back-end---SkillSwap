<file path="public/assets/styles/index-coordinador.css">
/* ==========================================
   ESTILOS GENERALES: BARRA DE BÚSQUEDA Y FILTROS
   ========================================== */

/* 1. Contenedor Principal (La fila) */
.barra-busqueda-coord {
    display: flex;
    align-items: center;
    gap: 15px; /* Espacio entre el buscador y el botón de filtro */
    width: 100%;
    margin-bottom: 25px;
    position: relative; /* Para controlar z-index si es necesario */
}

/* 2. Wrapper del Input (El buscador) */
.campo-busqueda-wrapper-coord {
    flex-grow: 1; /* Ocupa todo el espacio disponible */
    position: relative;
    display: flex;
    align-items: center;
}

/* El Input mismo */
.campo-busqueda-coord {
    width: 100%;
    padding: 12px 20px 12px 50px; /* Padding izquierdo para el icono de lupa */
    border-radius: 50px;
    border: 1px solid #ccc;
    font-size: 16px;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.campo-busqueda-coord:focus {
    border-color: #005a9c;
    box-shadow: 0 0 0 3px rgba(0, 90, 156, 0.1);
}

/* Icono de Lupa dentro del input */
.icono-lupa-coord {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none; /* Para que el clic pase al input */
    display: flex;
    align-items: center;
}

/* 3. Wrapper del Botón Filtro + Menú */
.wrapper-filtro-coord {
    position: relative; /* Indispensable para que el menú flote respecto a esto */
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 4. Botón Circular de Filtro */
.boton-filtros-coord {
    width: 50px;
    height: 50px;
    border-radius: 50%; /* Círculo perfecto */
    background-color: #ffffff;
    border: 1px solid #005a9c; /* Borde azul */
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.2s ease;
    padding: 0; /* Sin relleno extra */
}

.boton-filtros-coord:hover {
    background-color: #eef5ff; /* Azul muy suave al pasar el mouse */
    transform: scale(1.05); /* Pequeño zoom */
}

.icono-filtro-coord {
    display: flex;
    align-items: center;
    justify-content: center;
}

.icono-filtro-coord svg {
    width: 24px;
    height: 24px;
    fill: #005a9c; /* Color del icono */
}

/* 5. Menú Desplegable (Dropdown) */
.menu-filtros-busqueda {
    position: absolute;
    top: 120%; /* Un poco separado del botón hacia abajo */
    right: 0;  /* Alineado a la derecha del botón */
    width: 200px;
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    display: none; /* Oculto por defecto */
    z-index: 100;
    padding: 5px 0;
    overflow: hidden;
}

/* Clase activa para mostrar el menú (JS la activa) */
.menu-filtros-busqueda.activo {
    display: block;
    animation: fadeInDown 0.2s ease-out;
}

/* Opciones del menú */
.opcion-filtro {
    padding: 12px 20px;
    font-size: 14px;
    color: #333;
    cursor: pointer;
    transition: background-color 0.2s;
    border-bottom: 1px solid #f9f9f9;
}

.opcion-filtro:last-child {
    border-bottom: none;
}

.opcion-filtro:hover {
    background-color: #f0f7ff;
    color: #005a9c;
}

.opcion-filtro.seleccionado {
    font-weight: 700;
    background-color: #e6f0fa;
    color: #005a9c;
    border-left: 4px solid #005a9c;
}

/* Animación suave para el menú */
@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* Las opciones individuales dentro del menú */
.opcion-filtro {
    padding: 10px 20px;
    font-size: 0.95rem;
    color: #333;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    font-family: 'Poppins', sans-serif;
}


.opcion-filtro:hover {
    background-color: #f4f8fb; /* Un azul muy clarito */
    color: #005A9C;
}


.opcion-filtro.seleccionado {
    background-color: #e8f0fe;
    color: #005A9C;
    font-weight: 600; /* Negrita */
    border-left: 3px solid #005A9C; /* Pequeña barra azul a la izquierda */
}

/* Pequeña animación para que no aparezca de golpe */
@keyframes aparecerMenu {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
/* =========================================
   DISEÑO RESPONSIVE: COORDINADOR
   ========================================= */

/* --- TABLETS Y MÓVILES (Pantallas menores a 1024px) --- */
@media (max-width: 1024px) {
    

    .panel-coordinador-grid {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)) !important;
