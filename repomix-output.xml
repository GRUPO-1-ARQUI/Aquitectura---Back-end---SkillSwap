    }

    /* 6. MODAL */
    .modal-contenido {
        width: 95%; 
        padding: 20px;
    }


}

/* =========================================
         (VERIFICACIONES)
   ========================================= */

@media (max-width: 768px) {

    /* CONTENEDOR PRINCIPAL */
    /* Quitamos el Grid para manejar la visibilidad con 'display: block' */
    .contenido-verificaciones-coord {
        display: block !important; 
        position: relative;
    }

    /* 2. LISTA DE CORREOS (Visible por defecto) */
    .panel-lista-correos {
        display: flex;  
        width: 100%;
        height: auto;
        overflow-y: visible; 
    }

    /* 3. DETALLES (Ocultos por defecto en móvil) */
    .panel-detalle-vacio-coord,
    .panel-detalle-completo-coord {
        display: none !important; 
        width: 100%;
    }

    /* --- ESTADO: CUANDO SE ABRE UN CORREO --- */
    
    /* Ocultamos la lista */
    .contenido-verificaciones-coord.mostrando-detalle .panel-lista-correos {
        display: none !important;
    }

    /* Mostramos el detalle */
    .contenido-verificaciones-coord.mostrando-detalle .panel-detalle-completo-coord {
        display: flex !important;
        animation: slideInRight 0.3s ease; 
    }

    /* Animación suave tipo app */
    @keyframes slideInRight {
