    color: #888;
}

.campo-comentario:focus {
    outline: none;
    border-color: #005a9c; 
    box-shadow: 0 0 0 3px rgba(0, 90, 156, 0.2);
}

.boton-enviar-calificacion {
    background-color: #005a9c; 
    color: white;
    border: none;
    border-radius: 8px;
    padding: 15px 30px;
    font-size: 18px;
